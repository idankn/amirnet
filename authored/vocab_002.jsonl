// AUTHORED VOCAB BATCH 002 — weighted towards C1, which batch 001 left empty.
// C1 is the exemption threshold (AMIRNET 134+), so it is the level most users
// are actually aiming at.
//
// Definitions and examples written here, not copied. Hebrew glosses are short
// on purpose: they orient, the English definition carries the meaning.
{"word": "discard", "pos": "verb", "cefr": "C1", "definition_en": "To get rid of something because it is no longer wanted or useful.", "example": "The team discarded its first three designs before finding one that worked.", "translation_he": "להשליך, לזנוח"}
{"word": "portray", "pos": "verb", "cefr": "C1", "definition_en": "To describe or represent someone in a particular way.", "example": "The article portrays him as a reformer, which his colleagues dispute.", "translation_he": "לתאר, להציג כ-"}
{"word": "relinquish", "pos": "verb", "cefr": "C1", "definition_en": "To give up something you hold, such as power, a claim or control.", "example": "She relinquished her seat on the board after twelve years.", "translation_he": "לוותר על, למסור"}
{"word": "salvage", "pos": "verb", "cefr": "C1", "definition_en": "To save something from a situation in which the rest is lost.", "example": "Little could be salvaged from the archive after the flood.", "translation_he": "לחלץ, להציל"}
{"word": "expedite", "pos": "verb", "cefr": "C1", "definition_en": "To make a process happen faster than it otherwise would.", "example": "A second reviewer was hired to expedite the approval process.", "translation_he": "לזרז"}
{"word": "alienate", "pos": "verb", "cefr": "C1", "definition_en": "To make someone feel distant or unwelcome, so that support is lost.", "example": "The pricing change alienated many of the firm's oldest customers.", "translation_he": "לנכר, להרחיק"}
{"word": "sustainable", "pos": "adjective", "cefr": "C1", "definition_en": "Able to continue over a long period without using up resources or causing lasting damage.", "example": "Fishing at this rate is not sustainable for more than a decade.", "translation_he": "בר-קיימא"}
{"word": "divergent", "pos": "adjective", "cefr": "C1", "definition_en": "Moving apart, or differing from one another.", "example": "The two studies reached sharply divergent conclusions from the same data.", "translation_he": "מתפצל, שונה בתכלית"}
{"word": "versatile", "pos": "adjective", "cefr": "C1", "definition_en": "Able to be used for many purposes, or able to do many things well.", "example": "The material is versatile enough for both packaging and insulation.", "translation_he": "רב-תכליתי"}
{"word": "robust", "pos": "adjective", "cefr": "C1", "definition_en": "Strong enough to withstand pressure, difficulty or criticism.", "example": "The findings held up under a robust review by outside experts.", "translation_he": "איתן, חסון"}
{"word": "integral", "pos": "adjective", "cefr": "C1", "definition_en": "Forming a necessary part of something, so that it cannot be removed.", "example": "Feedback from users became integral to how the product was designed.", "translation_he": "בלתי נפרד, חיוני"}
{"word": "ingenious", "pos": "adjective", "cefr": "C1", "definition_en": "Clever in an original and surprising way.", "example": "Her solution was ingenious: two problems solved by removing one wall.", "translation_he": "מחוכם, גאוני"}
{"word": "prohibitive", "pos": "adjective", "cefr": "C1", "definition_en": "So expensive or difficult that it prevents something from happening.", "example": "The cost of storage was prohibitive until batteries became cheaper.", "translation_he": "מונע, יקר מכדי"}
{"word": "intellect", "pos": "noun", "cefr": "C1", "definition_en": "The ability to think, reason and understand difficult ideas.", "example": "The role demands judgement and patience as much as intellect.", "translation_he": "שכל, כושר חשיבה"}
{"word": "remorse", "pos": "noun", "cefr": "C1", "definition_en": "Deep regret for something wrong that you have done.", "example": "He showed no remorse when the full extent of the damage emerged.", "translation_he": "חרטה, נקיפות מצפון"}
{"word": "continuity", "pos": "noun", "cefr": "C1", "definition_en": "The quality of going on without interruption or sudden change.", "example": "Keeping the same manager gave the department badly needed continuity.", "translation_he": "רציפות"}
{"word": "coverage", "pos": "noun", "cefr": "C1", "definition_en": "The extent to which something is reported, included or protected.", "example": "Rural areas still have poor mobile coverage despite years of investment.", "translation_he": "כיסוי; סיקור"}
{"word": "predecessor", "pos": "noun", "cefr": "C1", "definition_en": "The person who held a job or position before the current one.", "example": "Unlike her predecessor, she published the budget in full each year.", "translation_he": "קודם בתפקיד"}
{"word": "jurisdiction", "pos": "noun", "cefr": "C1", "definition_en": "The official power to make legal decisions, or the area where that power applies.", "example": "The dispute fell outside the jurisdiction of the local court.", "translation_he": "סמכות שיפוט"}
{"word": "scorn", "pos": "noun", "cefr": "C1", "definition_en": "Strong feeling that someone or something deserves no respect at all.", "example": "The proposal was met with scorn by almost everyone in the room.", "translation_he": "בוז, זלזול"}
{"word": "detach", "pos": "verb", "cefr": "B2", "definition_en": "To separate one thing from another it was joined to.", "example": "You can detach the keyboard and use the screen on its own.", "translation_he": "לנתק, להפריד"}
{"word": "evolve", "pos": "verb", "cefr": "B2", "definition_en": "To develop gradually into something different.", "example": "What began as a student project evolved into a national service.", "translation_he": "להתפתח, להתגלגל"}
{"word": "certify", "pos": "verb", "cefr": "B2", "definition_en": "To state officially, usually in writing, that something is true or meets a standard.", "example": "Only an approved inspector can certify that the wiring is safe.", "translation_he": "לאשר רשמית, להסמיך"}
{"word": "entitle", "pos": "verb", "cefr": "B2", "definition_en": "To give someone the right to have or do something.", "example": "The ticket entitles you to one free refill during the performance.", "translation_he": "להקנות זכות, לזכות ב-"}
{"word": "permeate", "pos": "verb", "cefr": "B2", "definition_en": "To spread through every part of something.", "example": "A quiet distrust of management had permeated the whole department.", "translation_he": "לחלחל, לפעפע"}
{"word": "equip", "pos": "verb", "cefr": "B2", "definition_en": "To provide someone or something with what is needed for a task.", "example": "The course is meant to equip graduates for work in a laboratory.", "translation_he": "לצייד, להכשיר"}
{"word": "successive", "pos": "adjective", "cefr": "B2", "definition_en": "Following one after another without a break.", "example": "Three successive governments promised the railway and none built it.", "translation_he": "עוקב, רצוף"}
{"word": "valid", "pos": "adjective", "cefr": "B2", "definition_en": "Legally or logically acceptable, and therefore able to be used or relied on.", "example": "Your ticket is valid for travel on any day except public holidays.", "translation_he": "תקף, בר-תוקף"}
{"word": "absurd", "pos": "adjective", "cefr": "B2", "definition_en": "So unreasonable that it seems ridiculous.", "example": "It seemed absurd to close the only library in a town of ten thousand.", "translation_he": "אבסורדי, מגוחך"}
{"word": "mediocre", "pos": "adjective", "cefr": "B2", "definition_en": "Not bad, but clearly not good either.", "example": "The reviews were mediocre and ticket sales fell within a fortnight.", "translation_he": "בינוני, לא מרשים"}
{"word": "decent", "pos": "adjective", "cefr": "B2", "definition_en": "Good enough to be acceptable, or honest and fair in behaviour.", "example": "They finally found a decent flat within walking distance of campus.", "translation_he": "הגון; סביר"}
{"word": "margin", "pos": "noun", "cefr": "B2", "definition_en": "The amount by which one thing exceeds another, or the empty space at the edge of a page.", "example": "The motion passed by a margin of just four votes.", "translation_he": "מרווח, הפרש; שוליים"}
{"word": "therapy", "pos": "noun", "cefr": "B2", "definition_en": "Treatment intended to help someone recover from illness or difficulty, usually without surgery.", "example": "Physical therapy restored most of the movement in his shoulder.", "translation_he": "טיפול"}
{"word": "downfall", "pos": "noun", "cefr": "B2", "definition_en": "The cause of someone losing their power, position or success.", "example": "Overexpansion into markets it did not understand proved the chain's downfall.", "translation_he": "נפילה, מפלה"}
{"word": "classify", "pos": "verb", "cefr": "B1", "definition_en": "To put things into groups according to what they have in common.", "example": "Librarians classify each new title before it reaches the shelves.", "translation_he": "לסווג"}
{"word": "deny", "pos": "verb", "cefr": "B1", "definition_en": "To say that something is not true, or to refuse someone what they ask for.", "example": "The company denied that any customer data had been exposed.", "translation_he": "להכחיש; לשלול"}
{"word": "strengthen", "pos": "verb", "cefr": "B1", "definition_en": "To make something more powerful, more solid or harder to break.", "example": "Steel cables were added to strengthen the roof before winter.", "translation_he": "לחזק"}
{"word": "deprive", "pos": "verb", "cefr": "B1", "definition_en": "To take something away from someone, or to prevent them from having it.", "example": "The new rules deprive part-time staff of the same travel allowance.", "translation_he": "לשלול מ-, למנוע מ-"}
{"word": "vary", "pos": "verb", "cefr": "B1", "definition_en": "To be different from one another, or to change over time.", "example": "Prices vary considerably between the coast and the interior.", "translation_he": "להשתנות; לגוון"}
{"word": "regain", "pos": "verb", "cefr": "B1", "definition_en": "To get back something you had lost.", "example": "It took the airline three years to regain the trust of its passengers.", "translation_he": "להשיב, לרכוש מחדש"}
{"word": "academic", "pos": "adjective", "cefr": "B1", "definition_en": "Relating to study, teaching and research at a university or school.", "example": "Her academic record was strong enough for any programme she chose.", "translation_he": "אקדמי, לימודי"}
{"word": "guilty", "pos": "adjective", "cefr": "B1", "definition_en": "Having done something wrong, or feeling bad about having done it.", "example": "He felt guilty about leaving the work to everyone else.", "translation_he": "אשם; מרגיש אשמה"}
{"word": "valuable", "pos": "adjective", "cefr": "B1", "definition_en": "Worth a lot of money, or very useful and important.", "example": "The interviews turned out to be the most valuable part of the study.", "translation_he": "בעל ערך, יקר"}
{"word": "aware", "pos": "adjective", "cefr": "B1", "definition_en": "Knowing that something exists or is happening.", "example": "Few passengers were aware that the route had changed that morning.", "translation_he": "מודע"}
{"word": "curious", "pos": "adjective", "cefr": "B1", "definition_en": "Wanting to know more about something, or strange in an interesting way.", "example": "A curious detail in the report went unnoticed for months.", "translation_he": "סקרן; מוזר"}
{"word": "struggle", "pos": "noun", "cefr": "B1", "definition_en": "A long effort against something difficult.", "example": "Keeping the clinic open has been a struggle since the funding was cut.", "translation_he": "מאבק, מאמץ"}
{"word": "breakthrough", "pos": "noun", "cefr": "B1", "definition_en": "A sudden important discovery or advance after a period of little progress.", "example": "The breakthrough came from a technique borrowed from another field.", "translation_he": "פריצת דרך"}
{"word": "proposal", "pos": "noun", "cefr": "B1", "definition_en": "A plan or suggestion put forward for others to consider.", "example": "The proposal was rejected twice before anyone read it properly.", "translation_he": "הצעה"}
{"word": "remedy", "pos": "noun", "cefr": "B1", "definition_en": "Something that solves a problem or cures an illness.", "example": "There is no simple remedy for a shortage that took decades to build.", "translation_he": "תרופה; פתרון"}
