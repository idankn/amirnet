// AUTHORED VOCAB BATCH 003 — B2 and C1, academic register.
//
// Chosen for words that plausibly appear on this exam: abstract nouns,
// precise verbs, evaluative adjectives. Concrete everyday nouns are in the
// source list but skipped — nobody needs "aubergine" for AMIRNET.
//
// Definitions written here, not copied. Hebrew glosses are short by design.
{"word": "accumulate", "pos": "verb", "cefr": "B2", "definition_en": "To gather in increasing quantity over a period of time.", "example": "Dust had accumulated on the shelves during the months the building stood empty.", "translation_he": "להצטבר, לצבור"}
{"word": "adverse", "pos": "adjective", "cefr": "B2", "definition_en": "Unfavourable, and likely to cause harm or difficulty.", "example": "The trial was halted after several patients reported adverse effects.", "translation_he": "שלילי, מזיק"}
{"word": "ambiguity", "pos": "noun", "cefr": "B2", "definition_en": "The state of having more than one possible meaning.", "example": "The ambiguity in the wording allowed both sides to claim they had won.", "translation_he": "דו-משמעות, עמימות"}
{"word": "analogy", "pos": "noun", "cefr": "B2", "definition_en": "A comparison that explains something unfamiliar by likening it to something known.", "example": "He drew an analogy between the immune system and a standing army.", "translation_he": "אנלוגיה, הקבלה"}
{"word": "anticipate", "pos": "verb", "cefr": "B2", "definition_en": "To expect something and often to prepare for it in advance.", "example": "Planners anticipated the shortage but had no budget to act on it.", "translation_he": "לצפות, להיערך מראש"}
{"word": "aspiration", "pos": "noun", "cefr": "B2", "definition_en": "A strong wish to achieve something, usually over the long term.", "example": "Her aspiration to study medicine survived two rejected applications.", "translation_he": "שאיפה"}
{"word": "assumption", "pos": "noun", "cefr": "B2", "definition_en": "Something taken to be true without being checked.", "example": "The forecast rested on the assumption that fuel prices would stay flat.", "translation_he": "הנחה, הנחת יסוד"}
{"word": "attainable", "pos": "adjective", "cefr": "B2", "definition_en": "Possible to reach or achieve with the resources available.", "example": "The committee set targets that were ambitious but still attainable.", "translation_he": "בר-השגה"}
{"word": "authoritative", "pos": "adjective", "cefr": "B2", "definition_en": "Reliable because it comes from real expertise, or spoken with confident command.", "example": "The volume remains the most authoritative account of the period.", "translation_he": "סמכותי, מוסמך"}
{"word": "abolish", "pos": "verb", "cefr": "B2", "definition_en": "To end a law, system or practice officially and permanently.", "example": "The tax was abolished after less than two years in force.", "translation_he": "לבטל, לחסל"}
{"word": "acquisition", "pos": "noun", "cefr": "B2", "definition_en": "The act of obtaining something, or the thing obtained.", "example": "The museum announced its most expensive acquisition in a decade.", "translation_he": "רכישה"}
{"word": "adjustment", "pos": "noun", "cefr": "B2", "definition_en": "A small change made to improve something or make it fit better.", "example": "A minor adjustment to the timetable removed most of the delays.", "translation_he": "התאמה, תיקון קל"}
{"word": "adversity", "pos": "noun", "cefr": "B2", "definition_en": "A period of serious difficulty or misfortune.", "example": "The region's recovery after such adversity surprised most observers.", "translation_he": "מצוקה, קושי"}
{"word": "amplify", "pos": "verb", "cefr": "B2", "definition_en": "To make something louder, stronger or more noticeable.", "example": "Social media tends to amplify the most extreme version of any argument.", "translation_he": "להגביר, להעצים"}
{"word": "approximate", "pos": "adjective", "cefr": "B2", "definition_en": "Close to exact but not precisely measured.", "example": "The approximate cost was given as forty million, subject to revision.", "translation_he": "מקורב, בקירוב"}
{"word": "assessment", "pos": "noun", "cefr": "B2", "definition_en": "A judgement formed after examining evidence carefully.", "example": "An independent assessment found the building structurally sound.", "translation_he": "הערכה, שומה"}
{"word": "attribute", "pos": "noun", "cefr": "B2", "definition_en": "A quality or feature regarded as belonging to something.", "example": "Patience is the attribute the role demands most and advertises least.", "translation_he": "תכונה, מאפיין"}
{"word": "alliance", "pos": "noun", "cefr": "B2", "definition_en": "An agreement between groups to work together for a shared purpose.", "example": "The alliance held only as long as both sides faced the same rival.", "translation_he": "ברית, שותפות"}
{"word": "articulate", "pos": "verb", "cefr": "B2", "definition_en": "To express an idea clearly enough for others to grasp it.", "example": "She was the first to articulate what everyone in the room already sensed.", "translation_he": "לנסח בבהירות, להביע"}
{"word": "attendance", "pos": "noun", "cefr": "B2", "definition_en": "The act of being present, or the number of people present.", "example": "Attendance fell every year after the fee was introduced.", "translation_he": "נוכחות, השתתפות"}
{"word": "availability", "pos": "noun", "cefr": "B2", "definition_en": "The extent to which something can be obtained or used.", "example": "Poor availability of housing near the campus deters many applicants.", "translation_he": "זמינות"}
{"word": "accessibility", "pos": "noun", "cefr": "B2", "definition_en": "How easily something can be reached, entered or understood.", "example": "The redesign improved accessibility for readers using screen readers.", "translation_he": "נגישות"}
{"word": "arrogant", "pos": "adjective", "cefr": "B2", "definition_en": "Behaving as though you are more important or capable than others.", "example": "His arrogant dismissal of the objection cost him the vote.", "translation_he": "יהיר, מתנשא"}
{"word": "attentive", "pos": "adjective", "cefr": "B2", "definition_en": "Paying close and continuous notice to something.", "example": "An attentive reader will spot the contradiction in the second chapter.", "translation_he": "קשוב, ערני"}
{"word": "abstraction", "pos": "noun", "cefr": "C1", "definition_en": "A general idea formed by removing the particular details of specific cases.", "example": "Justice remains an abstraction until it is tested against a real dispute.", "translation_he": "הפשטה, מושג מופשט"}
{"word": "accustomed", "pos": "adjective", "cefr": "C1", "definition_en": "Used to something through repeated experience of it.", "example": "Residents became accustomed to the noise within a few weeks.", "translation_he": "רגיל ל-, מורגל"}
{"word": "advantageous", "pos": "adjective", "cefr": "C1", "definition_en": "Giving a benefit or a better position than would otherwise be had.", "example": "The location proved advantageous once the new line opened.", "translation_he": "מועיל, כדאי"}
{"word": "adversary", "pos": "noun", "cefr": "C1", "definition_en": "Someone opposed to you in a contest, argument or conflict.", "example": "He treated every colleague who disagreed with him as an adversary.", "translation_he": "יריב, מתנגד"}
{"word": "alignment", "pos": "noun", "cefr": "C1", "definition_en": "The arrangement of things in a correct relative position, or agreement between aims.", "example": "There was little alignment between what the survey asked and what managers needed.", "translation_he": "יישור; התאמה, הלימה"}
{"word": "altruism", "pos": "noun", "cefr": "C1", "definition_en": "Concern for the welfare of others at some cost to yourself.", "example": "Economists have struggled to explain altruism among strangers.", "translation_he": "אלטרואיזם, נדיבות"}
{"word": "antiquated", "pos": "adjective", "cefr": "C1", "definition_en": "So old-fashioned that it is no longer suitable for present use.", "example": "The hospital was still running on antiquated record-keeping software.", "translation_he": "מיושן, ארכאי"}
{"word": "apprehensive", "pos": "adjective", "cefr": "C1", "definition_en": "Uneasy about something that is about to happen.", "example": "Staff were apprehensive about the merger long before it was announced.", "translation_he": "חושש, מודאג"}
{"word": "assertion", "pos": "noun", "cefr": "C1", "definition_en": "A confident statement made without offering proof.", "example": "The assertion that costs would fall was repeated but never demonstrated.", "translation_he": "טענה, קביעה"}
{"word": "cessation", "pos": "noun", "cefr": "C1", "definition_en": "The stopping of an activity, especially one that had continued for some time.", "example": "The treaty required an immediate cessation of all testing.", "translation_he": "הפסקה, חדילה"}
{"word": "circulate", "pos": "verb", "cefr": "C1", "definition_en": "To move around a system, or to be passed from one person to another.", "example": "The draft circulated among senior staff for a month before publication.", "translation_he": "להפיץ; לזרום, להסתובב"}
{"word": "citation", "pos": "noun", "cefr": "C1", "definition_en": "A reference to a source, given to show where information came from.", "example": "Every claim in the report carries a citation to the underlying data.", "translation_he": "ציטוט, מראה מקום"}
{"word": "collaborate", "pos": "verb", "cefr": "C1", "definition_en": "To work jointly with others on a shared piece of work.", "example": "Three universities collaborated on the survey over four years.", "translation_he": "לשתף פעולה"}
{"word": "compliance", "pos": "noun", "cefr": "C1", "definition_en": "The act of meeting a rule, standard or request.", "example": "Compliance with the safety code is checked twice a year.", "translation_he": "ציות, עמידה בדרישות"}
{"word": "comprise", "pos": "verb", "cefr": "C1", "definition_en": "To consist of, or to be made up of specified parts.", "example": "The collection comprises some four thousand photographs.", "translation_he": "להיות מורכב מ-, לכלול"}
{"word": "conform", "pos": "verb", "cefr": "C1", "definition_en": "To behave according to accepted rules, or to match a required standard.", "example": "Older buildings need not conform to the regulations introduced last year.", "translation_he": "להתאים, לציית"}
{"word": "conscientious", "pos": "adjective", "cefr": "C1", "definition_en": "Careful and thorough in doing what is required.", "example": "A conscientious editor would have caught the error before publication.", "translation_he": "מצפוני, יסודי"}
{"word": "conserve", "pos": "verb", "cefr": "C1", "definition_en": "To use something sparingly, or to protect it from loss and damage.", "example": "The scheme was designed to conserve water during the dry months.", "translation_he": "לשמר, לחסוך ב-"}
{"word": "consultation", "pos": "noun", "cefr": "C1", "definition_en": "The process of seeking opinions before a decision is made.", "example": "The plan went ahead despite months of public consultation opposing it.", "translation_he": "התייעצות, שימוע ציבורי"}
{"word": "contextual", "pos": "adjective", "cefr": "C1", "definition_en": "Relating to the circumstances that surround something and give it meaning.", "example": "Without contextual information the figures are almost impossible to read.", "translation_he": "הקשרי, תלוי־הקשר"}
{"word": "compulsion", "pos": "noun", "cefr": "C1", "definition_en": "An urge that is very hard to resist, or the state of being forced.", "example": "He described a compulsion to check the results every few minutes.", "translation_he": "דחף כפייתי; כפייה"}
{"word": "confinement", "pos": "noun", "cefr": "C1", "definition_en": "The state of being kept within limits or prevented from leaving.", "example": "Long confinement indoors was found to affect sleep more than diet.", "translation_he": "כליאה, הגבלת תנועה"}
{"word": "commend", "pos": "verb", "cefr": "C1", "definition_en": "To praise something formally, or to recommend it to others.", "example": "The inspectors commended the school for its handling of the transition.", "translation_he": "לשבח, להמליץ על"}
{"word": "clinical", "pos": "adjective", "cefr": "C1", "definition_en": "Relating to the treatment of patients, or unemotional and detached in manner.", "example": "Her clinical assessment of the failure left nobody comfortable.", "translation_he": "קליני; ענייני, מנותק רגשית"}
{"word": "complementary", "pos": "adjective", "cefr": "C1", "definition_en": "Combining with something else in a way that improves both.", "example": "The two studies use complementary methods and reach the same conclusion.", "translation_he": "משלים"}
{"word": "aimless", "pos": "adjective", "cefr": "C1", "definition_en": "Without any clear purpose or direction.", "example": "The discussion grew aimless once the chair left the room.", "translation_he": "חסר מטרה"}
{"word": "ceaseless", "pos": "adjective", "cefr": "C1", "definition_en": "Continuing without any pause.", "example": "The ceaseless traffic outside made the ground-floor rooms unusable.", "translation_he": "בלתי פוסק"}
