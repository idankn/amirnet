// AUTHORED VOCAB BATCH 004 — B2 and C1, continuing the academic register.
//
// Definitions written here, not copied. Hebrew glosses are short by design;
// a semicolon separates genuinely distinct senses.
{"word": "deceptive", "pos": "adjective", "cefr": "B2", "definition_en": "Giving an impression that is not true.", "example": "The building's plain front is deceptive; the interior is enormous.", "translation_he": "מטעה"}
{"word": "decisive", "pos": "adjective", "cefr": "B2", "definition_en": "Settling a matter, or able to make firm choices quickly.", "example": "Her intervention proved decisive in a debate that had gone on for hours.", "translation_he": "מכריע; החלטי"}
{"word": "deficit", "pos": "noun", "cefr": "B2", "definition_en": "The amount by which something falls short, especially money spent over money received.", "example": "The council closed its deficit by delaying repairs rather than raising taxes.", "translation_he": "גירעון, חוסר"}
{"word": "deliberate", "pos": "adjective", "cefr": "B2", "definition_en": "Done on purpose rather than by accident, or slow and careful.", "example": "The omission was deliberate, and the committee later explained why.", "translation_he": "מכוון; מדוד, שקול"}
{"word": "demanding", "pos": "adjective", "cefr": "B2", "definition_en": "Requiring a lot of effort, skill or attention.", "example": "The course is demanding but the drop-out rate is surprisingly low.", "translation_he": "תובעני, מאתגר"}
{"word": "desirable", "pos": "adjective", "cefr": "B2", "definition_en": "Worth having or wanting, for good reasons.", "example": "A shorter commute is desirable but rarely decisive when choosing a job.", "translation_he": "רצוי, נחשק"}
{"word": "dilemma", "pos": "noun", "cefr": "B2", "definition_en": "A situation requiring a choice between options that are both unwelcome.", "example": "The dilemma was whether to close one branch or reduce hours at every branch.", "translation_he": "דילמה, התלבטות"}
{"word": "dimension", "pos": "noun", "cefr": "B2", "definition_en": "A measurement of size, or an aspect of a situation.", "example": "The report added a political dimension the researchers had not considered.", "translation_he": "מימד; היבט"}
{"word": "discipline", "pos": "noun", "cefr": "B2", "definition_en": "Controlled behaviour maintained by training, or a branch of academic study.", "example": "Economics borrows methods from a discipline it once ignored entirely.", "translation_he": "משמעת; תחום דעת"}
{"word": "discredit", "pos": "verb", "cefr": "B2", "definition_en": "To damage the reputation of someone or the credibility of an idea.", "example": "A single flawed study was enough to discredit two decades of work.", "translation_he": "להכפיש, לערער אמינות"}
{"word": "discriminate", "pos": "verb", "cefr": "B2", "definition_en": "To treat one group unfairly, or to recognise a difference between things.", "example": "The test cannot discriminate between the two conditions at an early stage.", "translation_he": "להפלות; להבחין בין"}
{"word": "dismiss", "pos": "verb", "cefr": "B2", "definition_en": "To reject an idea without serious consideration, or to remove someone from a job.", "example": "The board dismissed the objection in under a minute.", "translation_he": "לדחות על הסף; לפטר"}
{"word": "displace", "pos": "verb", "cefr": "B2", "definition_en": "To force something or someone out of their usual place.", "example": "The new reservoir displaced four villages along the valley floor.", "translation_he": "לעקור, לדחוק ממקומו"}
{"word": "disposal", "pos": "noun", "cefr": "B2", "definition_en": "The act of getting rid of something, or the availability of something for use.", "example": "Safe disposal of the old batteries cost more than replacing them.", "translation_he": "סילוק, פינוי; רשות"}
{"word": "dispute", "pos": "noun", "cefr": "B2", "definition_en": "A disagreement, especially one that continues for some time.", "example": "The boundary dispute was settled only after both maps were re-examined.", "translation_he": "מחלוקת, סכסוך"}
{"word": "disrupt", "pos": "verb", "cefr": "B2", "definition_en": "To interrupt something so that it cannot continue normally.", "example": "Roadworks disrupted deliveries across the district for a fortnight.", "translation_he": "לשבש, להפריע"}
{"word": "distortion", "pos": "noun", "cefr": "B2", "definition_en": "A change that misrepresents the true shape, sound or meaning of something.", "example": "Averaging the two groups introduced a distortion nobody noticed for years.", "translation_he": "עיוות"}
{"word": "diversion", "pos": "noun", "cefr": "B2", "definition_en": "A change of route or attention away from the intended one.", "example": "The announcement served as a diversion from the figures published that morning.", "translation_he": "הסחה; מעקף"}
{"word": "domestic", "pos": "adjective", "cefr": "B2", "definition_en": "Relating to the home, or to a country's own internal affairs.", "example": "Domestic demand recovered long before exports did.", "translation_he": "ביתי; פנים־מדינתי"}
{"word": "drought", "pos": "noun", "cefr": "B2", "definition_en": "A long period with far less rain than normal.", "example": "Three years of drought emptied reservoirs that had never run low before.", "translation_he": "בצורת"}
{"word": "eligible", "pos": "adjective", "cefr": "B2", "definition_en": "Meeting the conditions required to qualify for something.", "example": "Only households below the threshold were eligible for the grant.", "translation_he": "זכאי, כשיר"}
{"word": "eloquent", "pos": "adjective", "cefr": "B2", "definition_en": "Speaking or writing in a way that is fluent and persuasive.", "example": "His eloquent defence of the proposal changed several votes.", "translation_he": "רהוט, משכנע"}
{"word": "endorse", "pos": "verb", "cefr": "B2", "definition_en": "To declare public support or approval for something.", "example": "Two former inspectors endorsed the new guidance in writing.", "translation_he": "לתמוך פומבית, לאשר"}
{"word": "endurance", "pos": "noun", "cefr": "B2", "definition_en": "The ability to keep going through difficulty or over a long period.", "example": "The role calls for endurance more than for brilliance.", "translation_he": "סיבולת, כוח עמידה"}
{"word": "enforce", "pos": "verb", "cefr": "B2", "definition_en": "To make sure a rule or law is obeyed.", "example": "The rule existed for a decade before anyone tried to enforce it.", "translation_he": "לאכוף"}
{"word": "emergence", "pos": "noun", "cefr": "B2", "definition_en": "The process of coming into existence or becoming noticed.", "example": "The emergence of cheap sensors changed what could be measured at all.", "translation_he": "הופעה, היווצרות"}
{"word": "effectiveness", "pos": "noun", "cefr": "B2", "definition_en": "The degree to which something produces the result intended.", "example": "Nobody had tested the effectiveness of the scheme before extending it.", "translation_he": "יעילות, אפקטיביות"}
{"word": "detrimental", "pos": "adjective", "cefr": "C1", "definition_en": "Causing harm or damage, often gradually.", "example": "Long hours proved detrimental to exactly the productivity they were meant to raise.", "translation_he": "מזיק, פוגעני"}
{"word": "deprivation", "pos": "noun", "cefr": "C1", "definition_en": "The lack of things regarded as necessary for a decent life.", "example": "The study linked early deprivation to outcomes measured thirty years later.", "translation_he": "מחסור, חסך"}
{"word": "degradation", "pos": "noun", "cefr": "C1", "definition_en": "A decline in quality or condition, or treatment that removes someone's dignity.", "example": "Soil degradation cost the region more than any single drought.", "translation_he": "הידרדרות, שחיקה"}
{"word": "demographic", "pos": "adjective", "cefr": "C1", "definition_en": "Relating to the structure of a population, such as its age or size.", "example": "The demographic shift was visible in school enrolment a decade earlier.", "translation_he": "דמוגרפי"}
{"word": "depiction", "pos": "noun", "cefr": "C1", "definition_en": "The way something is shown or described in words or images.", "example": "The depiction of the period in that novel is vivid but unreliable.", "translation_he": "תיאור, ייצוג"}
{"word": "discourse", "pos": "noun", "cefr": "C1", "definition_en": "Serious discussion of a subject, spoken or written.", "example": "The term entered public discourse long before anyone defined it.", "translation_he": "שיח"}
{"word": "disdain", "pos": "noun", "cefr": "C1", "definition_en": "The feeling that something is beneath your respect.", "example": "She spoke of the earlier findings with barely concealed disdain.", "translation_he": "בוז, זלזול"}
{"word": "diverge", "pos": "verb", "cefr": "C1", "definition_en": "To move or develop in different directions from a common point.", "example": "The two estimates diverge sharply after the third year.", "translation_he": "להתפצל, להתרחק זה מזה"}
{"word": "dominant", "pos": "adjective", "cefr": "C1", "definition_en": "Most powerful, most common or most influential.", "example": "The dominant explanation went unchallenged for almost forty years.", "translation_he": "דומיננטי, שולט"}
{"word": "drawback", "pos": "noun", "cefr": "C1", "definition_en": "A disadvantage of something that is otherwise worth having.", "example": "The main drawback of the method is how long it takes to run.", "translation_he": "חיסרון"}
{"word": "duration", "pos": "noun", "cefr": "C1", "definition_en": "The length of time something continues.", "example": "Neither the intensity nor the duration of the effect was recorded.", "translation_he": "משך זמן"}
{"word": "daunting", "pos": "adjective", "cefr": "C1", "definition_en": "Intimidating because of the difficulty or size of what is involved.", "example": "Rebuilding the archive from scratch was a daunting prospect.", "translation_he": "מרתיע, מאיים"}
{"word": "elusive", "pos": "adjective", "cefr": "C1", "definition_en": "Hard to find, catch or define clearly.", "example": "A precise definition of the term has proved elusive for decades.", "translation_he": "חמקמק, קשה לתפיסה"}
{"word": "envisage", "pos": "verb", "cefr": "C1", "definition_en": "To picture something as a future possibility.", "example": "The founders never envisaged the service being used this way.", "translation_he": "לחזות, לדמיין מראש"}
{"word": "ethical", "pos": "adjective", "cefr": "C1", "definition_en": "Concerning what is morally right, or conforming to accepted standards of conduct.", "example": "The ethical objection was raised only after the data had been collected.", "translation_he": "אתי, מוסרי"}
{"word": "exploitation", "pos": "noun", "cefr": "C1", "definition_en": "Unfair use of people for gain, or the use of a resource for profit.", "example": "Commercial exploitation of the site was banned once the fossils were found.", "translation_he": "ניצול"}
{"word": "fatigue", "pos": "noun", "cefr": "C1", "definition_en": "Extreme tiredness, or weakening of a material after repeated stress.", "example": "Metal fatigue rather than the storm brought the structure down.", "translation_he": "עייפות; התעייפות חומר"}
{"word": "formulate", "pos": "verb", "cefr": "C1", "definition_en": "To express an idea or plan in a clear and considered form.", "example": "It took three meetings to formulate a question the survey could actually ask.", "translation_he": "לנסח, לגבש"}
{"word": "fraction", "pos": "noun", "cefr": "C1", "definition_en": "A small part of something larger.", "example": "Only a fraction of the applications were read before the deadline passed.", "translation_he": "חלק קטן, שבר"}
{"word": "hostile", "pos": "adjective", "cefr": "C1", "definition_en": "Openly opposed or unfriendly, or unfavourable to survival and growth.", "example": "The reception was hostile enough that the proposal was withdrawn.", "translation_he": "עוין"}
{"word": "hypocrisy", "pos": "noun", "cefr": "C1", "definition_en": "Claiming standards of behaviour that you do not follow yourself.", "example": "Critics pointed to the hypocrisy of regulating an industry the ministry subsidised.", "translation_he": "צביעות"}
{"word": "impediment", "pos": "noun", "cefr": "C1", "definition_en": "Something that obstructs progress.", "example": "Distance remained the greatest impediment to attendance at evening classes.", "translation_he": "מכשול, מעצור"}
{"word": "impoverished", "pos": "adjective", "cefr": "C1", "definition_en": "Made very poor, or stripped of something that gave richness.", "example": "The region was left impoverished long after the mines had closed.", "translation_he": "מדולדל, עני"}
{"word": "heighten", "pos": "verb", "cefr": "C1", "definition_en": "To make a feeling or effect stronger.", "example": "The delay only heightened suspicion that something had gone wrong.", "translation_he": "להגביר, לחדד"}
{"word": "elaborate", "pos": "adjective", "cefr": "C1", "definition_en": "Involving many carefully arranged parts or details.", "example": "An elaborate system of checks had grown up around a very simple decision.", "translation_he": "מורכב, מפורט"}
