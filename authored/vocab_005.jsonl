// AUTHORED VOCAB BATCH 005 — B2 and C1 academic register, weighted to the
// exemption band (C1 = AMIRNET 134+). Every word is drawn from
// wordlists/targets.tsv, so its CEFR level traces to CEFR-J or Octanove rather
// than to our own judgement. Definitions and examples are written here and are
// never lifted from a dictionary — see CLAUDE.md section 5.
//
{"word": "alleviate", "pos": "verb", "cefr": "C1", "definition_en": "To make pain, pressure or a problem less severe without removing it entirely.", "example": "The new funding alleviated the shortage but did not solve it.", "translation_he": "להקל, להפיג"}
{"word": "allege", "pos": "verb", "cefr": "C1", "definition_en": "To state something as true before it has been proved.", "example": "The report alleges that the figures were altered, though no evidence is offered.", "translation_he": "לטעון (ללא הוכחה)"}
{"word": "align", "pos": "verb", "cefr": "C1", "definition_en": "To bring something into agreement or a straight line with something else.", "example": "The committee aligned its recommendations with the existing policy.", "translation_he": "ליישר; להתאים"}
{"word": "abound", "pos": "verb", "cefr": "C1", "definition_en": "To exist in very large numbers.", "example": "Theories abound, but reliable data on the period is scarce.", "translation_he": "לשפוע, להימצא בשפע"}
{"word": "apt", "pos": "adjective", "cefr": "C1", "definition_en": "Well suited to the situation, or likely to do a particular thing.", "example": "It was an apt comparison, and the audience grasped it at once.", "translation_he": "הולם, קולע; נוטה ל-"}
{"word": "avid", "pos": "adjective", "cefr": "C1", "definition_en": "Extremely keen on an activity or interest.", "example": "An avid reader, she finished three volumes over the holiday.", "translation_he": "נלהב, שוקק"}
{"word": "benign", "pos": "adjective", "cefr": "C1", "definition_en": "Gentle and harmless; in medicine, not dangerous to health.", "example": "What seemed a benign change to the rules had large consequences.", "translation_he": "שפיר; מיטיב, לא מזיק"}
{"word": "altruistic", "pos": "adjective", "cefr": "C1", "definition_en": "Acting for the good of others rather than for personal gain.", "example": "Her motives were genuinely altruistic; she stood to gain nothing.", "translation_he": "אלטרואיסטי, זולתני"}
{"word": "candid", "pos": "adjective", "cefr": "C1", "definition_en": "Honest and direct, even when the truth is uncomfortable.", "example": "In a candid interview the director admitted the project had failed.", "translation_he": "כן, גלוי לב"}
{"word": "cite", "pos": "verb", "cefr": "C1", "definition_en": "To refer to a source or example in support of an argument.", "example": "He cited three studies, none of which supported his conclusion.", "translation_he": "לצטט, להביא כאסמכתא"}
{"word": "compel", "pos": "verb", "cefr": "C1", "definition_en": "To force someone to act, by authority or by circumstance.", "example": "Falling revenue compelled the company to close two branches.", "translation_he": "לאלץ, לכפות"}
{"word": "comply", "pos": "verb", "cefr": "C1", "definition_en": "To act in accordance with a rule, request or standard.", "example": "Laboratories that fail to comply with the standard lose their licence.", "translation_he": "לציית, לעמוד בדרישות"}
{"word": "concur", "pos": "verb", "cefr": "C1", "definition_en": "To agree with an opinion or conclusion.", "example": "Two of the three reviewers concurred with the original finding.", "translation_he": "להסכים, לתמוך בדעה"}
{"word": "confide", "pos": "verb", "cefr": "C1", "definition_en": "To tell someone something private, trusting them to keep it.", "example": "She confided in a colleague before telling anyone else.", "translation_he": "לגלות סוד, לבטוח ולספר"}
{"word": "convoluted", "pos": "adjective", "cefr": "C1", "definition_en": "So complicated in structure that it is hard to follow.", "example": "The argument was so convoluted that its conclusion was lost.", "translation_he": "מסובך, מפותל"}
{"word": "crave", "pos": "verb", "cefr": "C1", "definition_en": "To want something very strongly.", "example": "After years abroad he craved the ordinary routines of home.", "translation_he": "להשתוקק, לכסוף"}
{"word": "credible", "pos": "adjective", "cefr": "C1", "definition_en": "Believable enough to be taken seriously.", "example": "Without a named source the claim is not credible.", "translation_he": "אמין, מהימן"}
{"word": "crude", "pos": "adjective", "cefr": "C1", "definition_en": "Rough and unrefined, made without skill or precision.", "example": "The first model was crude, but it proved the principle.", "translation_he": "גס, גולמי, לא מעודן"}
{"word": "customary", "pos": "adjective", "cefr": "C1", "definition_en": "Usual because of long-established practice.", "example": "It is customary for the outgoing chair to introduce the successor.", "translation_he": "מקובל, נהוג"}
{"word": "cynical", "pos": "adjective", "cefr": "C1", "definition_en": "Believing that people act from selfish motives rather than good ones.", "example": "He took a cynical view of the donation, assuming it bought influence.", "translation_he": "ציני"}
{"word": "degrade", "pos": "verb", "cefr": "C1", "definition_en": "To reduce the quality, value or dignity of something.", "example": "Repeated copying degrades the image until the text is unreadable.", "translation_he": "לפגום, להשפיל, לרדד"}
{"word": "depict", "pos": "verb", "cefr": "C1", "definition_en": "To represent something in words or pictures.", "example": "The novel depicts the city as noisy, crowded and entirely alive.", "translation_he": "לתאר, להציג"}
{"word": "dispense", "pos": "verb", "cefr": "C1", "definition_en": "To give out something in measured amounts; with 'with', to manage without it.", "example": "The clinic dispenses medication only against a written prescription.", "translation_he": "לחלק, לספק; לוותר על"}
{"word": "dissect", "pos": "verb", "cefr": "C1", "definition_en": "To cut something apart, or to examine an idea in fine detail.", "example": "The committee dissected the proposal clause by clause.", "translation_he": "לנתח לפרטים, לפרק"}
{"word": "durable", "pos": "adjective", "cefr": "C1", "definition_en": "Able to last a long time without breaking down.", "example": "The agreement proved durable, surviving three changes of government.", "translation_he": "עמיד, בר-קיימא"}
{"word": "eccentric", "pos": "adjective", "cefr": "C1", "definition_en": "Behaving in a way that is strange but harmless.", "example": "His eccentric filing system was impenetrable to everyone but him.", "translation_he": "אקסצנטרי, מוזר"}
{"word": "eclectic", "pos": "adjective", "cefr": "C1", "definition_en": "Drawn from a wide and varied range of sources.", "example": "Her eclectic training in physics and music shaped the whole design.", "translation_he": "אקלקטי, רב-מקורות"}
{"word": "elevate", "pos": "verb", "cefr": "C1", "definition_en": "To raise something to a higher level, position or status.", "example": "The discovery elevated a minor researcher to national prominence.", "translation_he": "להעלות, לרומם"}
{"word": "elude", "pos": "verb", "cefr": "C1", "definition_en": "To escape from something, or to remain beyond someone's understanding.", "example": "The explanation eluded them for another decade.", "translation_he": "לחמוק; לא להיתפס להבנה"}
{"word": "embark", "pos": "verb", "cefr": "C1", "definition_en": "To begin something new and demanding.", "example": "She embarked on a study that would occupy the next eight years.", "translation_he": "לצאת לדרך, להתחיל מיזם"}
{"word": "evoke", "pos": "verb", "cefr": "C1", "definition_en": "To bring a memory, feeling or image into the mind.", "example": "The photograph evoked a summer she had not thought about in years.", "translation_he": "לעורר, להעלות זיכרון"}
{"word": "exert", "pos": "verb", "cefr": "C1", "definition_en": "To apply force, influence or effort.", "example": "The moon exerts enough pull to move entire oceans.", "translation_he": "להפעיל כוח או השפעה"}
{"word": "forfeit", "pos": "verb", "cefr": "C1", "definition_en": "To lose a right or possession as a penalty for something.", "example": "Candidates who arrive late forfeit the whole session.", "translation_he": "לאבד כעונש, להפסיד זכות"}
{"word": "glean", "pos": "verb", "cefr": "C1", "definition_en": "To gather information slowly and in small amounts.", "example": "What little we know was gleaned from letters and receipts.", "translation_he": "ללקט, לאסוף בהדרגה"}
{"word": "impede", "pos": "verb", "cefr": "C1", "definition_en": "To slow something down or get in its way.", "example": "Poor record-keeping impeded the investigation for months.", "translation_he": "לעכב, להפריע"}
{"word": "impervious", "pos": "adjective", "cefr": "C1", "definition_en": "Not letting anything through, or unaffected by influence and criticism.", "example": "He was impervious to argument once he had settled on a view.", "translation_he": "אטום, חסין"}
{"word": "implicate", "pos": "verb", "cefr": "C1", "definition_en": "To show that someone is involved in something wrong.", "example": "The records implicated two senior managers in the scheme.", "translation_he": "להפליל, לקשור למעשה"}
{"word": "inherent", "pos": "adjective", "cefr": "C1", "definition_en": "Existing in something as a permanent, inseparable quality.", "example": "There is a risk inherent in any measurement of this kind.", "translation_he": "מובנה, טבוע, אינהרנטי"}
{"word": "insightful", "pos": "adjective", "cefr": "C1", "definition_en": "Showing a clear and deep understanding of something.", "example": "Her insightful reading of the data changed how the team worked.", "translation_he": "מעמיק, בעל תובנה"}
{"word": "instinctive", "pos": "adjective", "cefr": "C1", "definition_en": "Done automatically, without conscious reasoning.", "example": "His instinctive reaction was to apologise before he understood why.", "translation_he": "אינסטינקטיבי, דחפי"}
{"word": "intuitive", "pos": "adjective", "cefr": "C1", "definition_en": "Understood immediately, without needing explanation or proof.", "example": "The interface is intuitive enough that no manual is required.", "translation_he": "אינטואיטיבי, מובן מאליו"}
{"word": "latent", "pos": "adjective", "cefr": "C1", "definition_en": "Present but not yet visible or active.", "example": "The disagreement was latent for years before it surfaced.", "translation_he": "רדום, חבוי, סמוי"}
{"word": "loom", "pos": "verb", "cefr": "C1", "definition_en": "To appear large and threatening, especially of something approaching.", "example": "The deadline loomed over every discussion that month.", "translation_he": "לרחף מעל, להתקרב מאיים"}
{"word": "marginal", "pos": "adjective", "cefr": "C1", "definition_en": "So small as to be barely important, or at the edge of something.", "example": "The improvement was marginal and well within the margin of error.", "translation_he": "שולי, זניח"}
{"word": "methodical", "pos": "adjective", "cefr": "C1", "definition_en": "Done in an orderly, step-by-step way.", "example": "A methodical search of the archive turned up the missing page.", "translation_he": "שיטתי, מסודר"}
{"word": "negligible", "pos": "adjective", "cefr": "C1", "definition_en": "Too small to be worth considering.", "example": "The cost is negligible compared with the savings it produces.", "translation_he": "זניח, מבוטל"}
{"word":"obscure","pos":"verb","cefr":"C1","definition_en":"To make something difficult to see or understand.","example":"A long introduction obscures the claim the paper is actually making.","translation_he":"לטשטש, להסתיר"}
{"word": "bypass", "pos": "verb", "cefr": "C1", "definition_en": "To go around something, or to avoid dealing with it.", "example": "The team bypassed the usual approval process and paid for it later.", "translation_he": "לעקוף"}
{"word": "bequeath", "pos": "verb", "cefr": "C1", "definition_en": "To leave something to someone after one's death, or pass it to later generations.", "example": "The scholar bequeathed her entire library to the university.", "translation_he": "להוריש"}
{"word": "congregate", "pos": "verb", "cefr": "C1", "definition_en": "To come together in a group.", "example": "Students congregated outside the hall long before the doors opened.", "translation_he": "להתקהל, להתאסף"}
{"word": "docile", "pos": "adjective", "cefr": "C1", "definition_en": "Quiet and easy to control or teach.", "example": "The animals are docile enough to be handled by children.", "translation_he": "צייתן, נוח לשליטה"}
{"word": "adjoin", "pos": "verb", "cefr": "C1", "definition_en": "To be next to and touching something.", "example": "The reading room adjoins the archive, so material never leaves the building.", "translation_he": "לגבול ב-, להיות צמוד"}
{"word": "aesthetic", "pos": "adjective", "cefr": "C1", "definition_en": "Concerned with beauty or with the appreciation of art.", "example": "The objection was aesthetic rather than practical.", "translation_he": "אסתטי"}
{"word": "appalling", "pos": "adjective", "cefr": "C1", "definition_en": "Shockingly bad.", "example": "Conditions in the older wing were appalling by any standard.", "translation_he": "מזעזע, נורא"}
{"word": "conjure", "pos": "verb", "cefr": "C1", "definition_en": "To make something appear, as if by magic, or to call it to mind.", "example": "A single phrase conjured the whole afternoon for her.", "translation_he": "להעלות באוב, לזמן; לעורר בדמיון"}
{"word": "antiquity", "pos": "noun", "cefr": "C1", "definition_en": "The distant past, especially the era of ancient Greece and Rome.", "example": "The practice can be traced back to antiquity.", "translation_he": "העת העתיקה"}
{"word": "conformity", "pos": "noun", "cefr": "C1", "definition_en": "Behaviour that matches what a group expects.", "example": "The study measured how quickly conformity overrides private judgement.", "translation_he": "קונפורמיות, היצמדות לנורמה"}
{"word": "constraint", "pos": "noun", "cefr": "C1", "definition_en": "Something that limits what can be done.", "example": "Time was the binding constraint, not money.", "translation_he": "אילוץ, מגבלה"}
{"word": "conviction", "pos": "noun", "cefr": "C1", "definition_en": "A firmly held belief, or a formal finding of guilt in court.", "example": "She argued with the conviction of someone who had tested the idea herself.", "translation_he": "אמונה איתנה; הרשעה"}
{"word": "credibility", "pos": "noun", "cefr": "C1", "definition_en": "The quality of being believed and trusted.", "example": "One retracted paper cost the laboratory years of credibility.", "translation_he": "אמינות"}
{"word": "cynicism", "pos": "noun", "cefr": "C1", "definition_en": "The belief that people are motivated mainly by self-interest.", "example": "Years of broken promises had bred a deep cynicism among the staff.", "translation_he": "ציניות"}
{"word": "deceit", "pos": "noun", "cefr": "C1", "definition_en": "The act of making someone believe something untrue.", "example": "The whole arrangement rested on a small, carefully maintained deceit.", "translation_he": "הונאה, מרמה"}
{"word": "demise", "pos": "noun", "cefr": "C1", "definition_en": "The end or failure of something, or a person's death.", "example": "The demise of the printing press was predicted far too early.", "translation_he": "קץ, שקיעה; פטירה"}
{"word": "detriment", "pos": "noun", "cefr": "C1", "definition_en": "Harm or damage caused to something.", "example": "He worked long hours, to the detriment of his health.", "translation_he": "נזק, פגיעה"}
{"word": "disillusionment", "pos": "noun", "cefr": "C1", "definition_en": "The disappointment felt when something turns out worse than believed.", "example": "Her disillusionment with the field grew with every unrepeatable result.", "translation_he": "התפכחות, אכזבה"}
{"word": "divergence", "pos": "noun", "cefr": "C1", "definition_en": "The process of moving apart or becoming different.", "example": "A small divergence in method produced very different conclusions.", "translation_he": "סטייה, התפצלות"}
{"word": "endorsement", "pos": "noun", "cefr": "C1", "definition_en": "Public support or approval given to something.", "example": "The endorsement of three major journals settled the debate.", "translation_he": "תמיכה, אישור פומבי"}
{"word": "faction", "pos": "noun", "cefr": "C1", "definition_en": "A small group within a larger one that disagrees with the rest.", "example": "A faction within the committee blocked the vote for a year.", "translation_he": "פלג, סיעה"}
{"word": "fragmentation", "pos": "noun", "cefr": "C1", "definition_en": "The process of breaking into separate, disconnected parts.", "example": "Fragmentation of the habitat proved more damaging than its loss.", "translation_he": "פיצול, התפוררות"}
{"word": "exodus", "pos": "noun", "cefr": "C1", "definition_en": "The departure of a large number of people at once.", "example": "The closure triggered an exodus of researchers to other institutions.", "translation_he": "יציאה המונית"}
{"word": "flattery", "pos": "noun", "cefr": "C1", "definition_en": "Excessive praise, usually offered to gain something.", "example": "He was immune to flattery and suspicious of anyone who tried it.", "translation_he": "חנופה"}
{"word": "alter", "pos": "verb", "cefr": "B2", "definition_en": "To change something, usually in a small or partial way.", "example": "A single word was altered, and the meaning of the clause reversed.", "translation_he": "לשנות"}
{"word": "aspire", "pos": "verb", "cefr": "B2", "definition_en": "To have a strong ambition to achieve something.", "example": "She aspired to a career in research long before she had the training.", "translation_he": "לשאוף"}
{"word": "assert", "pos": "verb", "cefr": "B2", "definition_en": "To state something firmly and confidently.", "example": "The author asserts a connection that the evidence does not support.", "translation_he": "לטעון בתוקף"}
{"word": "assess", "pos": "verb", "cefr": "B2", "definition_en": "To judge the quality, value or size of something.", "example": "Examiners assess the writing task on grammar and structure alone.", "translation_he": "להעריך, לאמוד"}
{"word": "cease", "pos": "verb", "cefr": "B2", "definition_en": "To stop happening or to bring something to an end.", "example": "Production ceased in 1974 and never resumed.", "translation_he": "לחדול, להפסיק"}
{"word": "clarify", "pos": "verb", "cefr": "B2", "definition_en": "To make something easier to understand.", "example": "A single diagram clarified what three pages of text had not.", "translation_he": "להבהיר"}
{"word": "coincide", "pos": "verb", "cefr": "B2", "definition_en": "To happen at the same time, or to be in agreement.", "example": "The two findings coincide, which is why the result is trusted.", "translation_he": "לחפוף, להתרחש בו-זמנית"}
{"word": "compensate", "pos": "verb", "cefr": "B2", "definition_en": "To make up for something lost or lacking.", "example": "Careful preparation compensated for the shortage of time.", "translation_he": "לפצות, לקזז"}
{"word": "compile", "pos": "verb", "cefr": "B2", "definition_en": "To collect information from different places and arrange it.", "example": "He compiled the list from a dozen separate archives.", "translation_he": "לערוך, לקבץ"}
{"word": "conceal", "pos": "verb", "cefr": "B2", "definition_en": "To hide something so it cannot be seen or known.", "example": "The report concealed more than it revealed.", "translation_he": "להסתיר"}
{"word": "concede", "pos": "verb", "cefr": "B2", "definition_en": "To admit that something is true, often reluctantly.", "example": "She conceded the point but not the argument.", "translation_he": "להודות, לוותר בוויכוח"}
{"word": "conceive", "pos": "verb", "cefr": "B2", "definition_en": "To form an idea or plan in the mind.", "example": "The scheme was conceived quickly and executed over ten years.", "translation_he": "להגות, לתכנן במחשבה"}
{"word": "condemn", "pos": "verb", "cefr": "B2", "definition_en": "To express strong disapproval of something.", "example": "The practice was condemned long before it was made illegal.", "translation_he": "לגנות"}
{"word": "confine", "pos": "verb", "cefr": "B2", "definition_en": "To keep something within limits, or to keep someone in a closed space.", "example": "The study confined itself to speakers under twenty-five.", "translation_he": "להגביל, לתחום; לכלוא"}
{"word": "confront", "pos": "verb", "cefr": "B2", "definition_en": "To face a difficulty or a person directly.", "example": "The field must confront the fact that most results are never repeated.", "translation_he": "להתמודד, לעמוד מול"}
{"word": "contaminate", "pos": "verb", "cefr": "B2", "definition_en": "To make something impure by adding a harmful substance.", "example": "A single contaminated sample invalidated the whole batch.", "translation_he": "לזהם"}
{"word": "cope", "pos": "verb", "cefr": "B2", "definition_en": "To deal successfully with a difficult situation.", "example": "Students who plan their time cope far better with the reading section.", "translation_he": "להתמודד, להסתדר"}
{"word": "deduce", "pos": "verb", "cefr": "B2", "definition_en": "To reach a conclusion by reasoning from what is known.", "example": "From the wear on the steps one can deduce how the building was used.", "translation_he": "להסיק"}
{"word": "deem", "pos": "verb", "cefr": "B2", "definition_en": "To consider something to be a certain way.", "example": "Any answer left blank is deemed incorrect.", "translation_he": "לראות כ-, להחשיב"}
{"word": "defy", "pos": "verb", "cefr": "B2", "definition_en": "To refuse to obey, or to resist something successfully.", "example": "The results defy the simplest explanation.", "translation_he": "להתריס, לא לציית; להתנגד"}
{"word": "despise", "pos": "verb", "cefr": "B2", "definition_en": "To dislike someone or something intensely.", "example": "He despised the practice but followed it for years.", "translation_he": "לבוז, לתעב"}
{"word": "detect", "pos": "verb", "cefr": "B2", "definition_en": "To discover or notice something that is not obvious.", "example": "The instrument detects changes too small for the eye to catch.", "translation_he": "לגלות, לאתר"}
{"word": "devote", "pos": "verb", "cefr": "B2", "definition_en": "To give time or effort entirely to one purpose.", "example": "She devoted the last decade of her career to the question.", "translation_he": "להקדיש"}
{"word": "dominate", "pos": "verb", "cefr": "B2", "definition_en": "To control or be the most important element in something.", "example": "One assumption dominated the field for thirty years.", "translation_he": "לשלוט, להיות דומיננטי"}
{"word": "enhance", "pos": "verb", "cefr": "B2", "definition_en": "To improve the quality or value of something.", "example": "Better lighting enhanced the readability of every exhibit.", "translation_he": "לשפר, להעצים"}
{"word": "evaluate", "pos": "verb", "cefr": "B2", "definition_en": "To judge something carefully in order to form an opinion of it.", "example": "Each proposal is evaluated against the same four criteria.", "translation_he": "להעריך, לשקול"}
{"word": "exceed", "pos": "verb", "cefr": "B2", "definition_en": "To be greater than a limit or expectation.", "example": "Demand exceeded every forecast the company had made.", "translation_he": "לעלות על, לחרוג"}
{"word": "excel", "pos": "verb", "cefr": "B2", "definition_en": "To be very good at something.", "example": "He excelled at reading comprehension and struggled with restatement.", "translation_he": "להצטיין"}
{"word": "exclude", "pos": "verb", "cefr": "B2", "definition_en": "To leave someone or something out deliberately.", "example": "Incomplete responses were excluded from the analysis.", "translation_he": "להוציא, לא לכלול"}
{"word": "exploit", "pos": "verb", "cefr": "B2", "definition_en": "To use something fully, or to use someone unfairly for gain.", "example": "The design exploits a property of the material nobody had noticed.", "translation_he": "לנצל"}
{"word": "facilitate", "pos": "verb", "cefr": "B2", "definition_en": "To make a process easier.", "example": "A shared vocabulary facilitates agreement between the two fields.", "translation_he": "להקל, לאפשר"}
{"word":"foresee","pos":"verb","cefr":"B2","definition_en":"To expect that something will happen before it does.","example":"Nobody could foresee how quickly the method would be adopted.","translation_he":"לצפות מראש"}
{"word": "humiliate", "pos": "verb", "cefr": "B2", "definition_en": "To make someone feel ashamed in front of others.", "example": "Correcting him publicly humiliated him without improving the work.", "translation_he": "להשפיל"}
{"word": "illustrate", "pos": "verb", "cefr": "B2", "definition_en": "To make something clear by giving an example.", "example": "One case illustrates the problem better than any statistic.", "translation_he": "להמחיש, להדגים"}
{"word": "immerse", "pos": "verb", "cefr": "B2", "definition_en": "To put something completely into a liquid, or to involve oneself deeply.", "example": "He immersed himself in the language for a year and returned fluent.", "translation_he": "לטבול; לשקוע כולו ב-"}
{"word": "impose", "pos": "verb", "cefr": "B2", "definition_en": "To force a rule, opinion or burden on someone.", "example": "The deadline was imposed from above and nobody defended it.", "translation_he": "לכפות, להטיל"}
{"word": "incur", "pos": "verb", "cefr": "B2", "definition_en": "To bring a cost or penalty on oneself by one's own action.", "example": "Withdrawing late incurs the full fee.", "translation_he": "לספוג, להביא על עצמו"}
{"word": "indulge", "pos": "verb", "cefr": "B2", "definition_en": "To allow oneself or someone else something enjoyable.", "example": "The essay indulges a theory the evidence cannot carry.", "translation_he": "להתפנק, להרשות לעצמו"}
{"word": "infer", "pos": "verb", "cefr": "B2", "definition_en": "To work something out from evidence rather than being told it.", "example": "From the passage we can infer the author's opinion without it being stated.", "translation_he": "להסיק, להבין מכללא"}
{"word": "inhabit", "pos": "verb", "cefr": "B2", "definition_en": "To live in a particular place.", "example": "The species inhabits only two valleys in the entire range.", "translation_he": "לאכלס, להתגורר ב-"}
{"word": "integrate", "pos": "verb", "cefr": "B2", "definition_en": "To combine parts so that they work as one whole.", "example": "The two databases were integrated after a decade of separate development.", "translation_he": "לשלב, לאחד"}
{"word": "interfere", "pos": "verb", "cefr": "B2", "definition_en": "To get involved in something in a way that disturbs it.", "example": "Background noise interferes with the measurement.", "translation_he": "להפריע, להתערב"}
{"word": "interpret", "pos": "verb", "cefr": "B2", "definition_en": "To explain the meaning of something, or to understand it in a particular way.", "example": "The same result can be interpreted two ways, which is the whole difficulty.", "translation_he": "לפרש"}
{"word": "invoke", "pos": "verb", "cefr": "B2", "definition_en": "To refer to a rule or principle in support of an argument.", "example": "He invoked a precedent that turned out not to apply.", "translation_he": "להסתמך על, לצטט כסמכות"}
{"word": "acute", "pos": "adjective", "cefr": "B2", "definition_en": "Severe and sharp, or showing quick and accurate understanding.", "example": "She has an acute sense of when an argument is about to fail.", "translation_he": "חריף, חד; אקוטי"}
{"word": "ambiguous", "pos": "adjective", "cefr": "B2", "definition_en": "Having more than one possible meaning.", "example": "A question with an ambiguous stem is rejected, however good the options.", "translation_he": "דו-משמעי, עמום"}
{"word": "ample", "pos": "adjective", "cefr": "B2", "definition_en": "More than enough.", "example": "Fifteen minutes is ample for the passage but tight for the questions.", "translation_he": "בשפע, די והותר"}
{"word": "beneficial", "pos": "adjective", "cefr": "B2", "definition_en": "Producing a good or helpful result.", "example": "Short, frequent sessions are more beneficial than one long one.", "translation_he": "מועיל"}
{"word": "benevolent", "pos": "adjective", "cefr": "B2", "definition_en": "Kind and wishing to do good for others.", "example": "The fund was established by a benevolent former student.", "translation_he": "נדיב, מיטיב"}
{"word": "coherent", "pos": "adjective", "cefr": "B2", "definition_en": "Logically connected and easy to follow.", "example": "The paragraphs are well written but do not form a coherent argument.", "translation_he": "קוהרנטי, בהיר ומחובר"}
{"word": "compatible", "pos": "adjective", "cefr": "B2", "definition_en": "Able to exist or work together without conflict.", "example": "The two explanations are not compatible; one of them must be wrong.", "translation_he": "תואם, מתיישב עם"}
{"word": "competent", "pos": "adjective", "cefr": "B2", "definition_en": "Having enough skill to do something to an acceptable standard.", "example": "A competent translation, though it loses the rhythm of the original.", "translation_he": "כשיר, מיומן"}
{"word": "compulsory", "pos": "adjective", "cefr": "B2", "definition_en": "Required by a rule or law.", "example": "Attendance at the first session is compulsory.", "translation_he": "חובה, כפוי"}
{"word": "consistent", "pos": "adjective", "cefr": "B2", "definition_en": "Behaving or happening in the same way over time, or free of contradiction.", "example": "The results are consistent across all four laboratories.", "translation_he": "עקבי, תואם"}
{"word": "contemporary", "pos": "adjective", "cefr": "B2", "definition_en": "Belonging to the present time, or to the same period as something else.", "example": "Contemporary accounts of the event disagree on almost every detail.", "translation_he": "בן זמננו; בן אותה תקופה"}
{"word": "contradictory", "pos": "adjective", "cefr": "B2", "definition_en": "Containing statements that cannot both be true.", "example": "The witness gave two contradictory accounts within an hour.", "translation_he": "סותר"}
{"word": "conventional", "pos": "adjective", "cefr": "B2", "definition_en": "Following what is usually done, rather than being original.", "example": "The conventional reading of the poem has gone unchallenged for decades.", "translation_he": "מקובל, שגרתי, קונבנציונלי"}
{"word": "crucial", "pos": "adjective", "cefr": "B2", "definition_en": "Extremely important because other things depend on it.", "example": "Pacing is crucial: the section ends whether or not you have finished.", "translation_he": "מכריע, קריטי"}
{"word": "dense", "pos": "adjective", "cefr": "B2", "definition_en": "Packed closely together, or hard to read because of concentrated content.", "example": "The prose is dense, and a first reading rarely suffices.", "translation_he": "צפוף, דחוס"}
{"word": "distinguished", "pos": "adjective", "cefr": "B2", "definition_en": "Respected and successful because of notable achievement.", "example": "A distinguished career in a field almost nobody else entered.", "translation_he": "נודע, מכובד, מהולל"}
{"word": "economical", "pos": "adjective", "cefr": "B2", "definition_en": "Using resources carefully, without waste.", "example": "His writing is economical: no sentence does only one job.", "translation_he": "חסכוני, יעיל"}
{"word": "enduring", "pos": "adjective", "cefr": "B2", "definition_en": "Continuing to exist for a long time.", "example": "The method's enduring appeal lies in how little it assumes.", "translation_he": "מתמשך, בר-קיימא"}
{"word": "exceptional", "pos": "adjective", "cefr": "B2", "definition_en": "Unusually good, or unusual enough to be an exception.", "example": "Exceptional cases are excluded rather than explained away.", "translation_he": "יוצא דופן, מצוין"}
{"word": "excessive", "pos": "adjective", "cefr": "B2", "definition_en": "Much more than is necessary or reasonable.", "example": "Excessive detail in the introduction buries the actual claim.", "translation_he": "מופרז, מוגזם"}
{"word": "extensive", "pos": "adjective", "cefr": "B2", "definition_en": "Covering a large area or amount.", "example": "Extensive reading does more for vocabulary than any list.", "translation_he": "נרחב, מקיף"}
{"word": "figurative", "pos": "adjective", "cefr": "B2", "definition_en": "Using words in a non-literal way to create an image.", "example": "In its figurative sense the word has nothing to do with weather.", "translation_he": "מטאפורי, לא מילולי"}
{"word": "fierce", "pos": "adjective", "cefr": "B2", "definition_en": "Violent or intense in force or feeling.", "example": "Competition for the places is fierce and grows each year.", "translation_he": "עז, עז-מזג, אכזרי"}
{"word": "assemble", "pos": "verb", "cefr": "B2", "definition_en": "To gather people or parts together, or to put something together.", "example": "The sections are assembled from difficulty-tiered pools.", "translation_he": "להרכיב, לאסוף"}
{"word": "betray", "pos": "verb", "cefr": "B2", "definition_en": "To be disloyal to someone, or to reveal something unintentionally.", "example": "His tone betrayed a doubt the words were meant to hide.", "translation_he": "לבגוד; להסגיר בלי כוונה"}
{"word": "bewilder", "pos": "verb", "cefr": "B2", "definition_en": "To confuse someone completely.", "example": "The instructions bewildered even experienced candidates.", "translation_he": "לבלבל, להמם"}
{"word": "commemorate", "pos": "verb", "cefr": "B2", "definition_en": "To honour the memory of a person or event.", "example": "The lecture series commemorates the founder of the department.", "translation_he": "להנציח"}
{"word": "convert", "pos": "verb", "cefr": "B2", "definition_en": "To change something into a different form or purpose.", "example": "The raw score is converted to the 50-150 scale before it is reported.", "translation_he": "להמיר, להסב"}
{"word": "descend", "pos": "verb", "cefr": "B2", "definition_en": "To move down, or to have a particular origin.", "example": "The argument descends into detail long before it establishes its point.", "translation_he": "לרדת; להיות צאצא של"}
{"word": "exhibit", "pos": "verb", "cefr": "B2", "definition_en": "To show something publicly, or to display a quality.", "example": "The group exhibited none of the behaviour the theory predicted.", "translation_he": "להציג, לגלות (תכונה)"}
{"word": "infringe", "pos": "verb", "cefr": "B2", "definition_en": "To break a rule or law, or to limit someone's rights.", "example": "Reproducing the list would infringe the publisher's copyright.", "translation_he": "להפר, לפגוע בזכות"}
{"word": "legislate", "pos": "verb", "cefr": "B2", "definition_en": "To make laws.", "example": "It is difficult to legislate for every case the rule must cover.", "translation_he": "לחוקק"}
{"word": "investigate", "pos": "verb", "cefr": "B2", "definition_en": "To examine something carefully in order to find out the truth.", "example": "The committee investigated the discrepancy and found a clerical error.", "translation_he": "לחקור, לבדוק"}
