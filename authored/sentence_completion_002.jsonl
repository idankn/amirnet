// AUTHORED BATCH 002 — B1, B2 and C1.
//
// Distractors are varied deliberately across the batch. Batch 001 leaned on a
// small set of clearly-wrong words, and a bank that reuses the same handful
// teaches a test-taker to spot the pattern instead of the meaning.
//
// STATUS: stage 3 only. Not blind-checked, not shippable.
{"target_word": "confidence", "cefr": "B1", "sentence": "Years of small successes gradually gave her the ______ to apply for a senior post.", "correct_answer": "confidence", "distractors": ["furniture", "luggage", "scenery"], "explanation": "What repeated success gives someone before they attempt something harder is self-belief, which 'confidence' names. The other three are physical things that cannot be gained from success.", "difficulty_est": 2}
{"target_word": "symptom", "cefr": "B1", "sentence": "A persistent cough was the only ______ that appeared before the illness became serious.", "correct_answer": "symptom", "distractors": ["recipe", "souvenir", "invoice"], "explanation": "A cough appearing before an illness worsens is a sign of that illness, which 'symptom' means. None of the others is something an illness produces.", "difficulty_est": 2}
{"target_word": "motivate", "cefr": "B1", "sentence": "Small weekly targets seemed to ______ the team far better than a single distant deadline.", "correct_answer": "motivate", "distractors": ["translate", "photograph", "inherit"], "explanation": "Comparing two ways of getting a team to work points at encouragement, which 'motivate' means. You cannot translate, photograph or inherit a team into working harder.", "difficulty_est": 3}
{"target_word": "possess", "cefr": "B1", "sentence": "Very few candidates ______ both the technical skill and the patience the role requires.", "correct_answer": "possess", "distractors": ["rehearse", "dissolve", "evaporate"], "explanation": "Having two qualities at once is what 'possess' describes here. Skill and patience are not things that can be rehearsed as a pair, and they do not dissolve or evaporate.", "difficulty_est": 3}
{"target_word": "remarkable", "cefr": "B1", "sentence": "What she achieved with almost no funding was genuinely ______ by any standard.", "correct_answer": "remarkable", "distractors": ["magnetic", "rectangular", "waterproof"], "explanation": "An achievement made despite no funding is worth noticing, which 'remarkable' means. An achievement cannot be magnetic, rectangular or waterproof.", "difficulty_est": 3}
{"target_word": "recovery", "cefr": "B1", "sentence": "The patient's ______ was slower than expected but complete within six months.", "correct_answer": "recovery", "distractors": ["rehearsal", "envelope", "curtain"], "explanation": "Something belonging to a patient that can be slow and then complete is the return to health, which 'recovery' names. The others cannot be described as complete within six months in this sense.", "difficulty_est": 2}
{"target_word": "limited", "cefr": "B1", "sentence": "Access to the archive is ______ to researchers who have applied at least a month ahead.", "correct_answer": "limited", "distractors": ["adhesive", "hollow", "frozen"], "explanation": "Access granted only to a particular group is restricted, which 'limited' means. Access cannot be adhesive, hollow or frozen.", "difficulty_est": 3}
{"target_word": "punishment", "cefr": "B1", "sentence": "Critics argued that the ______ was far heavier than the offence deserved.", "correct_answer": "punishment", "distractors": ["saucepan", "souvenir", "melody"], "explanation": "Something weighed against an offence is the penalty for it, which 'punishment' names. The other three cannot be compared to an offence at all.", "difficulty_est": 2}
{"target_word": "unite", "cefr": "B1", "sentence": "The threat of closure did more to ______ the staff than any management initiative had.", "correct_answer": "unite", "distractors": ["laminate", "photograph", "memorise"], "explanation": "A shared threat bringing people together is what 'unite' describes. Staff are not laminated, photographed or memorised by a threat.", "difficulty_est": 3}
{"target_word": "endless", "cefr": "B1", "sentence": "The meeting felt ______, though the minutes later showed it had lasted only an hour.", "correct_answer": "endless", "distractors": ["adhesive", "circular", "frozen"], "explanation": "The contrast with 'only an hour' shows the meeting seemed to go on forever, which 'endless' means. A meeting cannot feel adhesive or frozen, and 'circular' would describe its logic rather than its length.", "difficulty_est": 3}
{"target_word": "organic", "cefr": "B1", "sentence": "The farm switched to ______ methods and stopped using chemical fertiliser altogether.", "correct_answer": "organic", "distractors": ["audible", "portable", "alphabetical"], "explanation": "Abandoning chemical fertiliser is exactly what 'organic' farming means. Farming methods cannot be audible, portable or alphabetical.", "difficulty_est": 2}
{"target_word": "courageous", "cefr": "B1", "sentence": "Speaking publicly against her own employer was a ______ decision that cost her the job.", "correct_answer": "courageous", "distractors": ["magnetic", "hollow", "rectangular"], "explanation": "Acting against your own interest at real personal cost is brave, which 'courageous' means. A decision cannot be magnetic or rectangular, and 'hollow' would describe a promise rather than a risk taken.", "difficulty_est": 3}
{"target_word": "overtake", "cefr": "B2", "sentence": "Online sales are expected to ______ shop sales within the next three years.", "correct_answer": "overtake", "distractors": ["rehearse", "laminate", "memorise"], "explanation": "One figure rising past another is what 'overtake' describes. Sales cannot rehearse, laminate or memorise anything.", "difficulty_est": 3}
{"target_word": "peak", "cefr": "B2", "sentence": "Demand reaches its ______ in late August and falls sharply once schools reopen.", "correct_answer": "peak", "distractors": ["apology", "envelope", "saucepan"], "explanation": "A high point that demand reaches before falling is its 'peak'. None of the other options is something demand can reach.", "difficulty_est": 3}
{"target_word": "candidate", "cefr": "B2", "sentence": "Only one ______ had any experience of managing a budget of that size.", "correct_answer": "candidate", "distractors": ["souvenir", "staircase", "envelope"], "explanation": "Someone being assessed for experience relevant to a role is a 'candidate'. The others are objects and cannot have experience.", "difficulty_est": 2}
{"target_word": "ignorant", "cefr": "B2", "sentence": "He was entirely ______ of the rules until someone finally showed him the handbook.", "correct_answer": "ignorant", "distractors": ["adhesive", "audible", "waterproof"], "explanation": "Not knowing the rules until shown them is what 'ignorant of' means. A person cannot be adhesive, audible or waterproof in relation to rules.", "difficulty_est": 4}
{"target_word": "outlook", "cefr": "B2", "sentence": "The company's ______ for the coming year improved considerably after it secured the government contract.", "correct_answer": "outlook", "distractors": ["staircase", "rehearsal", "saucepan"], "explanation": "Something 'for the coming year' that a contract improves is the expected future, which 'outlook' names. The others cannot be held for a coming year.", "difficulty_est": 4}
{"target_word": "mortgage", "cefr": "B2", "sentence": "Rising interest rates made the monthly ______ payments unaffordable for many households.", "correct_answer": "mortgage", "distractors": ["rehearsal", "curtain", "melody"], "explanation": "Monthly payments affected by interest rates are loan repayments on a home, which 'mortgage' names. Nothing else listed involves interest.", "difficulty_est": 3}
{"target_word": "peer", "cefr": "B2", "sentence": "Every article is read by at least one ______ before the journal agrees to publish it.", "correct_answer": "peer", "distractors": ["souvenir", "staircase", "bandage"], "explanation": "Someone of equal standing who reviews academic work before publication is a 'peer'. The other three cannot read anything.", "difficulty_est": 4}
{"target_word": "disappearance", "cefr": "B2", "sentence": "The sudden ______ of bees from the region alarmed farmers across three counties.", "correct_answer": "disappearance", "distractors": ["rehearsal", "invoice", "envelope"], "explanation": "Bees going from a region and alarming farmers describes them vanishing, which 'disappearance' names. The others cannot happen to bees.", "difficulty_est": 3}
{"target_word": "recreation", "cefr": "B2", "sentence": "The park was designed for ______ rather than for sport, with no marked pitches at all.", "correct_answer": "recreation", "distractors": ["invoice", "bandage", "cutlery"], "explanation": "Set against sport, and explained by the absence of pitches, the park is for relaxed leisure — 'recreation'. A park cannot be designed for an invoice, bandage or cutlery.", "difficulty_est": 4}
{"target_word": "mighty", "cefr": "B2", "sentence": "The ______ river that once powered every mill in the valley is now barely a stream.", "correct_answer": "mighty", "distractors": ["adhesive", "alphabetical", "portable"], "explanation": "A river that once powered every mill was powerful, and 'now barely a stream' sharpens that contrast. A river cannot be adhesive, alphabetical or portable.", "difficulty_est": 3}
{"target_word": "client", "cefr": "B2", "sentence": "The firm lost its largest ______ after missing three deadlines in a single quarter.", "correct_answer": "client", "distractors": ["staircase", "souvenir", "melody"], "explanation": "Someone a firm can lose by missing deadlines is a customer it works for, which 'client' names. A firm does not lose staircases or melodies through poor delivery.", "difficulty_est": 2}
{"target_word": "upheaval", "cefr": "C1", "sentence": "The merger caused months of ______ before anything resembling a routine returned.", "correct_answer": "upheaval", "distractors": ["rehearsal", "cutlery", "bandage"], "explanation": "Months of disruption ending when routine returns is what 'upheaval' describes. The other three cannot last for months or be caused by a merger.", "difficulty_est": 4}
{"target_word": "appalling", "cefr": "C1", "sentence": "Conditions in the older wing were ______, and the inspectors ordered it closed immediately.", "correct_answer": "appalling", "distractors": ["adhesive", "alphabetical", "portable"], "explanation": "Conditions bad enough to force immediate closure are shocking, which 'appalling' means. Conditions cannot be adhesive, alphabetical or portable.", "difficulty_est": 4}
{"target_word": "knowledgeable", "cefr": "C1", "sentence": "The guide was unusually ______ about the building's history and answered every question.", "correct_answer": "knowledgeable", "distractors": ["magnetic", "waterproof", "rectangular"], "explanation": "Answering every question about a history means knowing a great deal, which 'knowledgeable' means. A guide cannot be magnetic, waterproof or rectangular about history.", "difficulty_est": 4}
{"target_word": "suspension", "cefr": "C1", "sentence": "The player faced a three-match ______ following the incident in the second half.", "correct_answer": "suspension", "distractors": ["souvenir", "envelope", "bandage"], "explanation": "Being barred for three matches after an incident is a temporary ban, which 'suspension' names. None of the others can be measured in matches.", "difficulty_est": 4}
{"target_word": "sarcastic", "cefr": "C1", "sentence": "His reply was so ______ that nobody could tell whether he actually agreed.", "correct_answer": "sarcastic", "distractors": ["adhesive", "waterproof", "circular"], "explanation": "Saying the opposite of what you mean leaves listeners unsure of your real view, which is what 'sarcastic' produces. A reply cannot be adhesive or waterproof, and 'circular' would describe faulty reasoning rather than tone.", "difficulty_est": 5}
{"target_word": "congregate", "cefr": "C1", "sentence": "Students tend to ______ near the entrance whenever the weather turns cold.", "correct_answer": "congregate", "distractors": ["evaporate", "laminate", "translate"], "explanation": "People gathering in one place is what 'congregate' means. Students do not evaporate, laminate or translate near an entrance.", "difficulty_est": 4}
{"target_word": "confide", "cefr": "C1", "sentence": "She had nobody at work she could ______ in about how badly things were going.", "correct_answer": "confide", "distractors": ["rehearse", "laminate", "dissolve"], "explanation": "The pattern 'confide in someone' means to tell them something private, which fits having nobody to talk to. The other verbs do not take 'in' with a person in this way.", "difficulty_est": 5}
{"target_word": "hypocritical", "cefr": "C1", "sentence": "Critics called the policy ______, since the ministry had ignored the same rule for years.", "correct_answer": "hypocritical", "distractors": ["adhesive", "rectangular", "audible"], "explanation": "Demanding of others what you have not done yourself is what 'hypocritical' names, and the second clause supplies exactly that. A policy cannot be adhesive, rectangular or audible.", "difficulty_est": 5}
{"target_word": "insightful", "cefr": "C1", "sentence": "Her comments on the draft were brief but unusually ______, and changed the whole argument.", "correct_answer": "insightful", "distractors": ["waterproof", "alphabetical", "magnetic"], "explanation": "Brief comments that change an entire argument show deep understanding, which 'insightful' means. Comments cannot be waterproof, alphabetical or magnetic.", "difficulty_est": 4}
{"target_word": "diversity", "cefr": "C1", "sentence": "The ______ of plant life in the reserve is greater than anywhere else in the country.", "correct_answer": "diversity", "distractors": ["rehearsal", "staircase", "saucepan"], "explanation": "A quality of plant life that can be greater in one place than another is its variety, which 'diversity' names. The others cannot describe plant life.", "difficulty_est": 4}
{"target_word": "niche", "cefr": "C1", "sentence": "The company found a profitable ______ supplying parts that larger manufacturers ignored.", "correct_answer": "niche", "distractors": ["rehearsal", "bandage", "envelope"], "explanation": "A small specialised area of a market that others overlook is a 'niche'. None of the other options can be profitable or supply parts.", "difficulty_est": 5}
{"target_word": "compliant", "cefr": "C1", "sentence": "Only two of the twelve sites were fully ______ with the new safety regulations.", "correct_answer": "compliant", "distractors": ["adhesive", "alphabetical", "portable"], "explanation": "Meeting regulations in full is what 'compliant with' means. Sites can be adhesive, alphabetical or portable in other contexts, but none of those relates to regulations.", "difficulty_est": 4}
{"target_word": "meaningless", "cefr": "C1", "sentence": "Without a control group the results are essentially ______, however impressive they look.", "correct_answer": "meaningless", "distractors": ["waterproof", "adhesive", "circular"], "explanation": "Results that cannot be interpreted without a comparison carry no information, which 'meaningless' states. 'Circular' describes reasoning that assumes its conclusion, which is a different fault, and results cannot be waterproof or adhesive.", "difficulty_est": 5}
