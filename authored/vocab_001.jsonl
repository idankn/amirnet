// AUTHORED VOCAB BATCH 001.
//
// Definitions and example sentences are written here, not copied. A commercial
// dictionary's wording is copyrighted; these are ours. Hebrew glosses are
// deliberately short — a gloss orients the learner, the English definition
// carries the meaning.
//
// CEFR levels come from the CEFR-J list (see wordlists/README.md), so the level
// shown to a learner traces to published data rather than a guess.
{"word": "achieve", "pos": "verb", "cefr": "A2", "definition_en": "To succeed in reaching a goal, usually after effort over time.", "example": "She achieved a perfect score only after months of daily practice.", "translation_he": "להשיג, להגיע ליעד"}
{"word": "affect", "pos": "verb", "cefr": "B1", "definition_en": "To produce a change in something, or to influence how it develops.", "example": "Rising fuel prices affect almost every part of the economy.", "translation_he": "להשפיע על"}
{"word": "attitude", "pos": "noun", "cefr": "A2", "definition_en": "The way someone thinks and feels about something, shown in how they behave.", "example": "His attitude towards deadlines changed once he joined a larger team.", "translation_he": "גישה, יחס"}
{"word": "benefit", "pos": "noun", "cefr": "B1", "definition_en": "An advantage gained from something.", "example": "One benefit of the new schedule is that nobody travels during rush hour.", "translation_he": "תועלת, יתרון"}
{"word": "consider", "pos": "verb", "cefr": "A2", "definition_en": "To think about something carefully before deciding.", "example": "The council will consider three different sites before choosing one.", "translation_he": "לשקול, לשקול בכובד ראש"}
{"word": "determine", "pos": "verb", "cefr": "B1", "definition_en": "To decide something officially, or to be the factor that decides an outcome.", "example": "Rainfall in early spring largely determines the size of the harvest.", "translation_he": "לקבוע, להכריע"}
{"word": "effect", "pos": "noun", "cefr": "A2", "definition_en": "A change that happens because of something else.", "example": "The medication had no measurable effect on his blood pressure.", "translation_he": "השפעה, תוצאה"}
{"word": "establish", "pos": "verb", "cefr": "A2", "definition_en": "To set something up so that it lasts, or to prove that something is true.", "example": "The company established its first office abroad in 1994.", "translation_he": "להקים, לבסס"}
{"word": "evidence", "pos": "noun", "cefr": "A2", "definition_en": "Facts or signs that show whether something is true.", "example": "There is little evidence that the policy reduced traffic at all.", "translation_he": "ראיה, עדות"}
{"word": "factor", "pos": "noun", "cefr": "B2", "definition_en": "One of several things that together cause a result.", "example": "Cost was only one factor in the decision to close the branch.", "translation_he": "גורם, מרכיב"}
{"word": "immediate", "pos": "adjective", "cefr": "B1", "definition_en": "Happening at once, without any delay.", "example": "The new rule had an immediate effect on how staff recorded their hours.", "translation_he": "מיידי"}
{"word": "income", "pos": "noun", "cefr": "B1", "definition_en": "Money that a person or organisation regularly receives, usually from work.", "example": "Households on a low income were hit hardest by the price rise.", "translation_he": "הכנסה"}
{"word": "maintain", "pos": "verb", "cefr": "B1", "definition_en": "To keep something in the same condition, or to keep saying something is true.", "example": "The bridge is expensive to maintain but far too useful to close.", "translation_he": "לתחזק, לשמר; לטעון בעקביות"}
{"word": "obvious", "pos": "adjective", "cefr": "B1", "definition_en": "Easy to see or understand, needing no explanation.", "example": "The reason for the delay was obvious the moment we saw the queue.", "translation_he": "ברור, מובן מאליו"}
{"word": "purpose", "pos": "noun", "cefr": "A2", "definition_en": "The reason something is done, or what it is meant to do.", "example": "The purpose of the survey was to find out why members were leaving.", "translation_he": "מטרה, תכלית"}
{"word": "reduce", "pos": "verb", "cefr": "B1", "definition_en": "To make something smaller in size, amount or degree.", "example": "Switching to rail reduced the company's emissions by a third.", "translation_he": "להפחית, לצמצם"}
{"word": "require", "pos": "verb", "cefr": "B1", "definition_en": "To need something, or to officially demand it.", "example": "The course requires no previous knowledge of statistics.", "translation_he": "לדרוש, להזדקק ל-"}
{"word": "significant", "pos": "adjective", "cefr": "A2", "definition_en": "Large or important enough to be worth noticing.", "example": "There was a significant drop in applications after the fee was introduced.", "translation_he": "משמעותי, ניכר"}
{"word": "source", "pos": "noun", "cefr": "A2", "definition_en": "The place, person or thing that something comes from.", "example": "The report never names the source of its figures.", "translation_he": "מקור"}
{"word": "acknowledge", "pos": "verb", "cefr": "B1", "definition_en": "To admit that something is true, or to show you have noticed someone.", "example": "The manufacturer finally acknowledged that the fault was its own.", "translation_he": "להודות ב-, להכיר ב-"}
{"word": "adequate", "pos": "adjective", "cefr": "B2", "definition_en": "Enough for what is needed, though not more than that.", "example": "The lighting was adequate for reading but too dim for detailed work.", "translation_he": "מספיק, הולם"}
{"word": "assume", "pos": "verb", "cefr": "B1", "definition_en": "To accept that something is true without checking it.", "example": "Do not assume the data is accurate simply because it was published.", "translation_he": "להניח, לצאת מנקודת הנחה"}
{"word": "comprehensive", "pos": "adjective", "cefr": "B2", "definition_en": "Covering everything that is relevant, leaving nothing out.", "example": "The inspectors produced a comprehensive account of what went wrong.", "translation_he": "מקיף, כולל"}
{"word": "considerable", "pos": "adjective", "cefr": "B1", "definition_en": "Large in amount or degree, enough to matter.", "example": "Rebuilding the archive took considerable time and money.", "translation_he": "ניכר, רב"}
{"word": "constitute", "pos": "verb", "cefr": "B1", "definition_en": "To be the parts that something is made of, or to count as something.", "example": "Women constitute nearly two thirds of the workforce in this sector.", "translation_he": "להוות, להרכיב"}
{"word": "contradict", "pos": "verb", "cefr": "B2", "definition_en": "To say or show the opposite of something else, so both cannot be true.", "example": "The new figures contradict everything the earlier study concluded.", "translation_he": "לסתור, להכחיש"}
{"word": "imply", "pos": "verb", "cefr": "B2", "definition_en": "To suggest something without stating it directly.", "example": "Her silence seemed to imply that she disagreed with the plan.", "translation_he": "לרמוז, להשתמע"}
{"word": "inevitable", "pos": "adjective", "cefr": "B1", "definition_en": "Certain to happen and impossible to prevent.", "example": "Given how quickly the ice is retreating, some flooding is inevitable.", "translation_he": "בלתי נמנע"}
{"word": "justify", "pos": "verb", "cefr": "B2", "definition_en": "To give a good reason for something, showing it was right or necessary.", "example": "The board could not justify the expense to its members.", "translation_he": "להצדיק, לנמק"}
{"word": "modify", "pos": "verb", "cefr": "B1", "definition_en": "To change something slightly, usually to improve it or make it fit.", "example": "Engineers modified the design after the first round of testing.", "translation_he": "לשנות, להתאים"}
{"word": "perceive", "pos": "verb", "cefr": "B2", "definition_en": "To notice something, or to understand it in a particular way.", "example": "Younger customers perceive the brand quite differently from older ones.", "translation_he": "לתפוס, להבחין, לראות כ-"}
{"word": "reluctant", "pos": "adjective", "cefr": "B2", "definition_en": "Unwilling to do something, and slow to agree to it.", "example": "Investors remain reluctant to fund projects with no clear return.", "translation_he": "מהסס, לא ששׂ"}
{"word": "sufficient", "pos": "adjective", "cefr": "B1", "definition_en": "As much as is needed.", "example": "Suspicion alone is not sufficient grounds for an investigation.", "translation_he": "מספיק, די"}
{"word": "tendency", "pos": "noun", "cefr": "B1", "definition_en": "A habit of behaving in a certain way, or a general direction of change.", "example": "There is a tendency to blame the software when the process is at fault.", "translation_he": "נטייה, מגמה"}
{"word": "widespread", "pos": "adjective", "cefr": "B1", "definition_en": "Found over a large area or among many people.", "example": "The practice was widespread long before anyone tried to regulate it.", "translation_he": "נפוץ, רחב היקף"}
