# Copy to .env and fill in from your Supabase dashboard:
#   Project Settings -> API
#
# Both of these are safe to ship in the app bundle. The anon key is public by
# design — row-level security is what protects the question bank, not secrecy
# of this key.
#
# The SERVICE ROLE key does NOT belong here. It bypasses row-level security
# and must never reach the app. It goes in your shell environment when running
# `python -m pipeline.push_supabase`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
